# Postgres (via @prisma/adapter-pg)
DATABASE_URL=
DIRECT_URL=

# OpenAI (package recommendation)
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-5-mini

# Google OAuth / Calendar (discovery-call booking)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=
GOOGLE_OAUTH_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=
GOOGLE_MEETING_DEFAULT_TIMEZONE=

# ManyChat webhook shared secret (app/api/update-meeting)
INTERNAL_API_KEY=

NEXT_PUBLIC_NEXORU_WHATSAPP_NUMBER=

# Canonical origin of the onboarding app (e.g. https://app.nexoru.ai).
# Optional: unused CTA links become relative and the marketing site's
# host check falls back to "app.nexoru.ai" when this is unset.
NEXT_PUBLIC_APP_URL=
